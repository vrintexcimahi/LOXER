# ==============================================================================
# LOXER Environment Configuration Example
# ==============================================================================

# Mode 1: Local SQLite Database (Default, zero setup, fully offline)
VITE_USE_LOCAL_DB=true
VITE_DEFAULT_ADMIN_EMAIL=loxer-admin-1776448925326@example.com
DEFAULT_ADMIN_EMAIL=loxer-admin-1776448925326@example.com
# Required before enabling local Child Panel sessions (use a unique 32+ character secret).
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Mode 2: Cloud Supabase (Optional, if you want remote PostgreSQL)
# VITE_USE_LOCAL_DB=false
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Third-party job feeds (Optional)
CAREERJET_API_KEY=
RAPIDAPI_KEY=

# 9Router AI Gateway Configuration (Gemini 3.8 Flash High)
# ROUTER_BASE_URL=http://192.168.1.14:20128/v1
# ROUTER_API_KEY=sk-9router-direct
# ROUTER_VISION_MODEL=ag/gemini-3.8-flash-high

