# LOXER Mobile Environment Configuration
APP_ENV=production
APP_NAME="LOXER"
APP_BASE_URL="https://app.loxer.id"
API_BASE_URL="https://api.loxer.id"
REMOTE_CONFIG_URL="https://api.loxer.id/mobile/config"
FALLBACK_WEB_URL="https://loxer.web.id"

# Android Release Signing
ANDROID_KEYSTORE_PATH="/path/to/loxer-release.keystore"
ANDROID_KEY_ALIAS="loxer"
ANDROID_KEY_PASSWORD="YourKeyPassword"
ANDROID_STORE_PASSWORD="YourStorePassword"

# iOS Release Signing
APPLE_DEVELOPER_TEAM_ID="YOUR_TEAM_ID"
APPLE_BUNDLE_ID="id.web.loxer.app"
APPLE_PROVISIONING_PROFILE="Loxer_App_Store_Profile"
